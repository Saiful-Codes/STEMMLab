# Firebase Web SDK config — copy this file to .env and replace the placeholder
# values with the real ones from Firebase Console:
#   Project settings → Your apps → Web app → SDK setup and configuration → Config
#
# Notes:
# - All variables MUST be prefixed with EXPO_PUBLIC_ so Expo inlines them into
#   the JS bundle and they become readable via process.env at runtime.
# - Never commit .env with real values. .env is already in .gitignore.
# - These values appear in the shipped client bundle. That is expected for the
#   Firebase Web SDK — protect your data with Firebase Security Rules, not
#   secrecy of these keys.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789abcdef
